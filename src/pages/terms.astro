---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleContent from '../components/ArticleContent.astro';
const page = await getEntry('pages', 'privacy');
if (!page) throw new Error('The privacy policy is missing.');
const { Content } = await render(page);
---

<BaseLayout
  title={page.data.title}
  description="Privacy information for Guangwei Wang’s academic website: GitHub Pages hosting, Google Analytics, and contact."
  ><div class="container">
    <article class="article-shell">
      <header class="article-heading">
        <h1>{page.data.title}</h1>
      </header><ArticleContent><Content /></ArticleContent>
    </article>
  </div></BaseLayout
>
