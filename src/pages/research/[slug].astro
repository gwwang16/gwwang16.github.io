---
import { render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleContent from '../../components/ArticleContent.astro';
import PublicationList from '../../components/PublicationList.astro';
import { researchAreas, selectedPapers } from '../../lib/content';
export async function getStaticPaths() {
  return (await researchAreas()).map((area) => ({
    params: { slug: area.id },
    props: { area },
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { area } = Astro.props;
const { Content } = await render(area);
const papers = (await selectedPapers()).filter((paper) =>
  area.data.papers.includes(paper.id),
);
---

<BaseLayout title={area.data.title} description={area.data.summary}>
  <div class="container">
    <article class="article-shell">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Home</a></li><li aria-hidden="true">/</li><li>
            <a href="/#research">Research</a>
          </li>
        </ol>
      </nav>
      <header class="article-heading">
        <h1>{area.data.title}</h1><p class="article-description">
          {area.data.summary}
        </p>
      </header>
      <ArticleContent><Content /></ArticleContent>
      <section class="related-papers" aria-labelledby="related-papers-heading">
        <h2 id="related-papers-heading">Selected papers</h2>
        <PublicationList papers={papers} />
      </section>
      <div class="article-back">
        <a class="text-link" href="/publications/">More publications</a>
      </div>
    </article>
  </div>
</BaseLayout>
