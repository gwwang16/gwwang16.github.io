---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchVisual from '../components/ResearchVisual.astro';
import ResearchCard from '../components/ResearchCard.astro';
import PublicationList from '../components/PublicationList.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import GrantItem from '../components/GrantItem.astro';
import CourseItem from '../components/CourseItem.astro';
import MentoringItem from '../components/MentoringItem.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { selectedPapers, researchAreas, earlyWork } from '../lib/content';
const papers = (await selectedPapers())
  .filter(({ data }) => data.featuredOrder)
  .sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!);
const areas = await researchAreas();
const projects = await earlyWork();
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">GUANGWEI WANG · 王广玮</p>
      <h1 id="hero-heading">Guangwei Wang<span>.</span></h1>
      <p class="hero-position">
        {profile.role} · <a href={profile.links.university}
          >{profile.university}</a
        >
      </p>
      <p class="hero-thesis">
        Intelligent vehicles.<br />Precision manipulation.
      </p>
      <p class="hero-intro">
        I study how intelligent systems plan safe motion and control precise
        interactions—from autonomous vehicles on complex terrain to micro/nano
        manipulation.
      </p>
      <p class="hero-leadership">
        {profile.leadership}<br />{profile.department}
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/publications/"
          >Selected publications <Icon /></a
        >
        <a class="button button-text" href={profile.links.scholar}
          >Google Scholar <Icon name="external" /></a
        >
      </div>
    </div>
    <ResearchVisual />
  </section>
  <section
    class="section container"
    id="research"
    aria-labelledby="research-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">RESEARCH</p><h2 id="research-heading">
          Planning, control &amp; interaction.
        </h2>
      </div>
    </div>
    <div class="research-grid">
      {areas.map((area) => <ResearchCard area={area} />)}
    </div>
  </section>
  <section class="section paper-section" aria-labelledby="publications-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">SELECTED PUBLICATIONS</p><h2
            id="publications-heading"
          >
            Recent &amp; representative papers.
          </h2>
        </div>
        <a class="text-link" href="/publications/"
          >All selected papers <Icon /></a
        >
      </div>
      <p class="citation-legend">
        First-author and corresponding-author papers. <strong>Wang G</strong> = Guangwei
        Wang; <span>*</span> = corresponding author.
      </p>
      <PublicationList papers={papers} />
      <p class="archive-note">
        Full publication record: <a href={profile.links.scholar}
          >Google Scholar</a
        > · <a href={profile.links.researchgate}>ResearchGate</a>
      </p>
    </div>
  </section>
  <section
    class="section container"
    id="funding"
    aria-labelledby="funding-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">FUNDED RESEARCH</p><h2 id="funding-heading">
          Current projects.
        </h2>
      </div>
      <p class="section-description">
        Vehicle safety and compliant manipulation, supported by national,
        provincial, and industry funding.
      </p>
    </div>
    <ul class="grant-list">
      {profile.grants.map((grant) => <GrantItem {...grant} />)}
    </ul>
  </section>
  <section
    class="section about-section"
    id="background"
    aria-labelledby="background-heading"
  >
    <div class="container about-grid">
      <div class="about-copy">
        <p class="eyebrow">BACKGROUND</p><h2 id="background-heading">
          Research &amp; education.
        </h2>
        <p>{profile.biography}</p>
        <a class="text-link" href={profile.links.university}
          >Guizhou University profile <Icon name="external" /></a
        >
      </div>
      <ol class="experience-list">
        {
          profile.experience.map((experience) => (
            <ExperienceItem {...experience} />
          ))
        }
      </ol>
    </div>
  </section>
  <section
    class="section container"
    id="teaching"
    aria-labelledby="teaching-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">TEACHING &amp; SUPERVISION</p><h2
          id="teaching-heading"
        >
          In the classroom and beyond.
        </h2>
      </div>
    </div>
    <div class="teaching-grid">
      <div>
        <h3>Courses</h3><ul class="course-list">
          {profile.courses.map((course) => <CourseItem {...course} />)}
        </ul>
      </div>
      <div>
        <h3>Selected student achievements</h3><ul class="mentoring-list">
          {profile.mentoring.map((result) => <MentoringItem {...result} />)}
        </ul>
      </div>
    </div>
    <p class="book-note">
      Co-authored book: <span lang="zh-CN">{profile.book.title}</span>
      <span class="book-translation">({profile.book.translation})</span>. {
        profile.book.publisher
      }, {profile.book.year}. <a href={profile.links.university}
        >Details <Icon name="external" /></a
      >
    </p>
  </section>
  <section
    class="early-work-teaser container"
    aria-labelledby="early-work-heading"
  >
    <div>
      <p class="eyebrow">EARLIER WORK · STUDENT PROJECTS</p><h2
        id="early-work-heading"
      >
        Small builds, lasting foundations.
      </h2><p>
        A compact collection of early experiments in ROS, perception, autonomous
        driving, and robot learning.
      </p>
    </div>
    <ul class="early-work-links">
      {
        projects.map((project) => (
          <li>
            <a href={`/projects/#${project.id}`}>
              {project.title} <Icon />
            </a>
          </li>
        ))
      }
    </ul>
    <a class="text-link" href="/projects/">Browse the collection <Icon /></a>
  </section>
  <section
    class="recruitment container"
    id="contact"
    aria-labelledby="recruitment-heading"
  >
    <div>
      <p class="eyebrow">PROSPECTIVE STUDENTS &amp; COLLABORATORS</p><h2
        id="recruitment-heading"
      >
        Work with me.
      </h2>
      <p>{profile.recruitment}</p>
      <address>{profile.office}</address>
    </div>
    <a class="button button-primary" href={`mailto:${profile.email}`}
      >{profile.email} <Icon name="external" /></a
    >
  </section>
</BaseLayout>
