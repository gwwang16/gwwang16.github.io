---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchVisual from '../components/ResearchVisual.astro';
import ResearchItem from '../components/ResearchItem.astro';
import PublicationList from '../components/PublicationList.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import GrantItem from '../components/GrantItem.astro';
import CourseItem from '../components/CourseItem.astro';
import MentoringItem from '../components/MentoringItem.astro';
import { profile } from '../data/profile';
import { selectedPapers, researchAreas } from '../lib/content';
const papers = (await selectedPapers())
  .filter(({ data }) => data.featuredOrder)
  .sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!);
const areas = await researchAreas();
---

<BaseLayout>
  <section class="profile-section container" aria-labelledby="profile-heading">
    <div class="profile-header">
      <div class="profile-details">
        <div class="profile-name">
          <h1 id="profile-heading">{profile.name}</h1>
          <span lang="zh-CN">{profile.chineseName}</span>
        </div>
        <p class="profile-position">{profile.role}</p>
        <p>
          {profile.department}<br />{profile.university}, {profile.location}
        </p>
        <p>Email: <a href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <ul class="profile-links" aria-label="Academic profiles">
          <li><a href={profile.links.scholar}>Google Scholar</a></li>
          <li><a href={profile.links.researchgate}>ResearchGate</a></li>
          <li><a href={profile.links.orcid}>ORCID</a></li>
          <li><a href={profile.links.github}>GitHub</a></li>
          <li><a href={profile.links.university}>University profile</a></li>
        </ul>
      </div>
      <ResearchVisual />
    </div>
    <p class="profile-intro">{profile.biography}</p>
  </section>

  <section
    class="section container"
    id="research"
    aria-labelledby="research-heading"
  >
    <h2 id="research-heading">Research interests</h2>
    <ul class="research-list">
      {areas.map((area) => <ResearchItem area={area} />)}
    </ul>
  </section>

  <section class="section container" aria-labelledby="publications-heading">
    <div class="section-heading">
      <h2 id="publications-heading">Selected publications</h2>
      <a href="/publications/">All selected publications</a>
    </div>
    <p class="citation-legend">
      First-author and corresponding-author papers. <strong>Wang G</strong> = Guangwei
      Wang; * = corresponding author.
    </p>
    <PublicationList papers={papers} />
  </section>

  <section
    class="section container"
    id="funding"
    aria-labelledby="funding-heading"
  >
    <h2 id="funding-heading">Research projects</h2>
    <ul class="grant-list">
      {profile.grants.map((grant) => <GrantItem {...grant} />)}
    </ul>
  </section>

  <section
    class="section container"
    id="background"
    aria-labelledby="background-heading"
  >
    <h2 id="background-heading">Education and experience</h2>
    <ol class="experience-list">
      {
        profile.experience.map((experience) => (
          <ExperienceItem {...experience} />
        ))
      }
    </ol>
  </section>

  <section
    class="section container"
    id="teaching"
    aria-labelledby="teaching-heading"
  >
    <h2 id="teaching-heading">Teaching and student supervision</h2>
    <h3>Courses</h3>
    <ul class="course-list">
      {profile.courses.map((course) => <CourseItem {...course} />)}
    </ul>
    <h3>Selected student achievements</h3>
    <ul class="mentoring-list">
      {profile.mentoring.map((result) => <MentoringItem {...result} />)}
    </ul>
    <p class="book-note">
      Co-authored book: <span lang="zh-CN">{profile.book.title}</span>{
        ` (${profile.book.translation}). ${profile.book.publisher}, ${profile.book.year}. `
      }
      <a href={profile.links.university}>Details</a>
    </p>
  </section>

  <section class="section container" aria-labelledby="early-work-heading">
    <h2 id="early-work-heading">Earlier projects</h2>
    <p>
      Student projects in ROS, perception, autonomous driving, and robot
      learning are summarized in the <a href="/projects/"
        >earlier project collection</a
      >.
    </p>
  </section>

  <section
    class="section container"
    id="contact"
    aria-labelledby="contact-heading"
  >
    <h2 id="contact-heading">Contact and prospective students</h2>
    <p>{profile.recruitment}</p>
    <address><strong>Office:</strong> {profile.office}</address>
  </section>
</BaseLayout>
