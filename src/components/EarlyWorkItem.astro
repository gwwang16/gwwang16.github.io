---
import type { earlyWork } from '../lib/content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { imageSize } from 'image-size';
import Icon from './Icon.astro';
interface Props {
  project: Awaited<ReturnType<typeof earlyWork>>[number];
}
const { project } = Astro.props;
const size = imageSize(readFileSync(resolve('public', `.${project.image}`)));
const image = {
  src: project.image,
  width: size.width,
  height: size.height,
  format: size.type as ImageMetadata['format'],
};
---

<article class="early-work-item" id={project.id}>
  <Image
    src={image}
    alt={project.imageAlt ?? project.title}
    width={112}
    height={74}
    widths={[112, 224]}
    sizes="(max-width: 600px) 80px, 112px"
    fit="contain"
    format="webp"
    loading="lazy"
    decoding="async"
  />
  <div>
    <h2>{project.title}</h2><p>{project.description}</p>
    {
      project.repository && (
        <a
          class="text-link"
          href={project.repository}
          aria-label={`Source code for ${project.title}`}
        >
          Source code <Icon name="github" />
        </a>
      )
    }
    {
      project.demo && (
        <a
          class="text-link"
          href={project.demo}
          aria-label={`Recorded demo of ${project.title}`}
        >
          Recorded demo <Icon name="external" />
        </a>
      )
    }
  </div>
</article>
