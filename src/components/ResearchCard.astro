---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props {
  area: CollectionEntry<'research'>;
}
const { area } = Astro.props;
---

<article class="research-panel">
  <div class="research-icon"><Icon name={area.data.icon} /></div>
  <h3>{area.data.title}</h3>
  <p>{area.data.summary}</p>
  <ul class="tags">{area.data.topics.map((topic) => <li>{topic}</li>)}</ul>
  <a class="text-link" href={`/research/${area.id}/`}
    >Research overview <Icon /></a
  >
</article>
